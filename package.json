{
  "name": "tiptap-footnotes",
  "version": "3.0.1",
  "description": "A footnotes extension for Tiptap",
  "keywords": [
    "tiptap",
    "tiptap extension",
    "tiptap footnotes",
    "footnotes"
  ],
  "license": "MIT",
  "author": "Turki Aloufi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/buttondown/tiptap-footnotes.git"
  },
  "files": [
    "dist/"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsdown",
    "build:demo": "vite build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest --environment=jsdom",
    "prepack": "pnpm run build"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@eslint/js": "^9.39.1",
    "@tiptap/core": "^3.10.2",
    "@tiptap/extension-document": "^3.10.2",
    "@tiptap/extension-list-item": "^3.10.2",
    "@tiptap/extension-ordered-list": "^3.10.2",
    "@tiptap/extension-paragraph": "^3.10.2",
    "@tiptap/extension-placeholder": "^3.10.2",
    "@tiptap/extension-text": "^3.10.2",
    "@tiptap/pm": "^3.10.2",
    "@tiptap/react": "^3.10.2",
    "@tiptap/starter-kit": "^3.10.2",
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "5.1.0-rc-fb9a90fa48-20240614",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^15.15.0",
    "jsdom": "^24.1.3",
    "postcss": "^8.5.6",
    "publint": "^0.3.25",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.18",
    "tsdown": "^0.23.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  },
  "peerDependencies": {
    "@tiptap/core": "^3.0.0",
    "@tiptap/extension-list-item": "^3.0.0",
    "@tiptap/extension-ordered-list": "^3.0.0",
    "@tiptap/pm": "^3.0.0"
  }
}
