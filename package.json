{
  "name": "tiptap-footnotes",
  "version": "3.0.1",
  "description": "A footnotes extension for Tiptap",
  "keywords": [
    "footnotes",
    "tiptap",
    "tiptap extension",
    "tiptap footnotes"
  ],
  "license": "MIT",
  "author": "Turki Aloufi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/buttondown/tiptap-footnotes.git"
  },
  "files": [
    "dist/"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsdown",
    "build:demo": "vite build",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest --environment=jsdom",
    "prepack": "pnpm run build"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@changesets/cli": "^3.0.3",
    "@tailwindcss/vite": "^4.3.5",
    "@tiptap/core": "^3.33.0",
    "@tiptap/extension-document": "^3.33.0",
    "@tiptap/extension-list": "^3.33.0",
    "@tiptap/extension-paragraph": "^3.33.0",
    "@tiptap/extension-placeholder": "^3.33.0",
    "@tiptap/extension-text": "^3.33.0",
    "@tiptap/pm": "^3.33.0",
    "@tiptap/react": "^3.33.0",
    "@tiptap/starter-kit": "^3.33.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "jsdom": "^31.0.0",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "oxlint-tsgolint": "^7.0.2006",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "tsdown": "^0.23.7",
    "typescript": "7.1.0-beta",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "@tiptap/core": "^3.0.0",
    "@tiptap/extension-list": "^3.0.0",
    "@tiptap/pm": "^3.0.0"
  }
}
